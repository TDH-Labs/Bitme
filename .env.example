# Copy this file to .env (which is gitignored - never commit a filled-in copy) and fill in real
# values. See docs/DOCKER.md for the full walkthrough.

# The SERVER account-level xprv - the one secret this whole deployment actually needs to guard.
# Generate it yourself; this service never generates keys. Never share it, never commit it.
#
# For testnet: use a tprv (testnet private key). The setup wizard generates one automatically.
# For mainnet: use an xprv (mainnet private key).
COSIGNER_SERVER_XPRV=

# Port cosigner's HTTP API is published on (host side). Container-internal port is always 8080.
COSIGNER_HTTP_PORT=8080

# How many unused addresses ahead of the last-seen one to check on each chain when deciding
# whether a scriptPubkey is ours. 1000 is a safe default; raise it if you use a very wide
# receive-address gap in your wallet software.
COSIGNER_GAP_LIMIT=1000

# --- bitcoind connection -----------------------------------------------------------------------
# If you're using docker-compose.signet.yml (a bundled local signet node), leave these as-is -
# that override sets them for you. If you're pointing at your own node, fill these in instead
# and don't use the signet override.
BITCOIND_RPC_URL=http://bitcoind:38332
BITCOIND_RPC_USER=cosigner
BITCOIND_RPC_PASSWORD=change-me-to-a-real-password
# BITCOIND_RPC_COOKIE_FILE=/run/bitcoind/.cookie   # instead of USER/PASSWORD - mount it in,
                                                    # then set this and leave USER/PASSWORD unset

# --- For testnet: use docker-compose.testnet.yml instead of .signet.yml -------------------------
# The compose override sets BITCOIND_RPC_URL for you automatically. Uncomment these and
# comment out the signet values above if you're using the testnet override:
#
# BITCOIND_RPC_URL=http://bitcoind:18332
# BITCOIND_RPC_USER=cosigner
# BITCOIND_RPC_PASSWORD=change-me-to-a-real-password

# --- Nostr transport (optional) -----------------------------------------------------------------
# Only needed if wallet.toml has [nostr_transport] with nsec_env_var = "COSIGNER_NOSTR_NSEC" -
# leave unset otherwise. This service's own Nostr secret key (bech32 nsec or hex), used for the
# alternate, authenticated front door to the same HTTP API. Never share it, never commit it.
# COSIGNER_NOSTR_NSEC=
