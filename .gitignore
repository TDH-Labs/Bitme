bitme-cosigner/target
# Test-only, installed on demand by the wizard smoke test - never committed.
bitme-cosigner/node_modules
bitme-cosigner/package-lock.json
.env
config/wallet.toml
bitme-cosigner/wallet.toml
bitme-cosigner/server.xprv

# The app folder now ships empty data/ and config/ dirs (via .gitkeep) so Umbrel's installer
# creates them owned by 1000:1000 instead of Docker auto-creating them as root. Never commit
# anything real that lands in them at runtime.
bitme-cosigner/config/*
!bitme-cosigner/config/.gitkeep
bitme-cosigner/data/*
!bitme-cosigner/data/.gitkeep
