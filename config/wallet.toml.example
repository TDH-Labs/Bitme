# Copy this file into the cosigner data volume as config/wallet.toml and fill in your real
# values. In Docker, that's the volume mounted at /data - e.g.
#   docker compose cp config/wallet.toml.example cosigner:/data/config/wallet.toml
# then edit it in place, or edit this file first and copy the filled-in version in.
#
# [bitcoind] and [server] must NOT appear in this file - the container generates both itself,
# fresh on every start, from its own environment (BITCOIND_RPC_URL, COSIGNER_HTTP_PORT, etc. -
# see .env.example and docs/DOCKER.md). That's what lets the same image and the same file work
# unmodified for a plain docker-compose deployment and for Umbrel, which injects different
# bitcoind connection details for those same variables.

network = "signet"                 # start here. Only move to "mainnet" (with
                                    # i_understand_this_is_mainnet = true below) after you've
                                    # verified this whole setup end-to-end on signet.
# i_understand_this_is_mainnet = true
timelock_blocks = 4320             # ~30 days at 10 min/block. Any spend involving the MOBILE
                                    # key waits this long - that's both recovery paths. It is a
                                    # consensus rule baked into your addresses: changing it later
                                    # requires sweeping to a new descriptor. See the README.

[keys.satochip]
master_fingerprint = "00000000"    # 8 hex chars - e.g. Sparrow's "Master Fingerprint" field
derivation_path = "48h/1h/0h/2h"
xpub = "tpub..."                   # the extended PUBLIC key AT derivation_path - never a
                                    # private key, and never the master xpub

[keys.mobile]
master_fingerprint = "00000000"    # from Bitcoin Keeper
derivation_path = "48h/1h/0h/2h"
xpub = "tpub..."

[keys.server]
master_fingerprint = "00000000"    # must match the xprv you provide via [server_signing] below
derivation_path = "48h/1h/0h/2h"
xpub = "tpub..."

[server_signing]
# The SERVER account-level xprv is provided via the COSIGNER_SERVER_XPRV environment variable
# (see .env.example), never written into this file.
xprv_env_var = "COSIGNER_SERVER_XPRV"

# Only ever consulted once, to seed policy version 1 the very first time this service starts
# against a fresh data volume - after that, the running policy lives in the ledger database and
# can only be changed via a SATOCHIP-authorized POST /policy. See docs/DOCKER.md.
[policy]
max_tx_sat = 500000
max_daily_sat = 1000000
max_weekly_sat = 3000000
max_monthly_sat = 8000000
max_fee_sat = 50000
max_fee_rate_sat_per_vb = 200.0
# destination_whitelist = ["tb1q..."]   # optional; omit to allow any destination

[notify]
hold_seconds = 900                 # 15 minutes to review and veto before this service signs
sweep_interval_seconds = 5

[notify.ntfy]
url = "https://ntfy.sh/replace-with-a-private-topic-name"
# auth_token = "..."                # optional, for a self-hosted ntfy server requiring auth

# [notify.smtp]                     # optional second (or alternative) channel; both may be set
# host = "smtp.example.com"
# port = 587
# username = "cosigner@example.com"
# password = "..."
# from = "cosigner@example.com"
# to = "you@example.com"
